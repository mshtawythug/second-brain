#!/usr/bin/env bash
# Dev-checkout backcompat wrapper — delegates to the brain-uninstall-launchd console script.
# The console script (brain.bin.launchd:uninstall_main) is registered in pyproject.toml
# and available after `pip install -e .` or `pipx install .`.
#
# Requires the project venv to be activated OR brain-uninstall-launchd on PATH (e.g. via
# `pipx ensurepath`).
exec brain-uninstall-launchd "$@"
