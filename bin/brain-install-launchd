#!/usr/bin/env bash
# Dev-checkout backcompat wrapper — delegates to the brain-install-launchd console script.
# The console script (brain.bin.launchd:install_main) is registered in pyproject.toml
# and available after `pip install -e .` or `pipx install .`.
#
# Requires the project venv to be activated OR brain-install-launchd on PATH (e.g. via
# `pipx ensurepath`).
exec brain-install-launchd "$@"
