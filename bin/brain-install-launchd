#!/usr/bin/env bash
# Install LaunchAgents that supervise the brain wiki watcher + build daemon.
# Idempotent — safe to re-run.
#
# What this does:
#   1. Generates `~/Library/LaunchAgents/com.brain.watcher.plist` and
#      `~/Library/LaunchAgents/com.brain.build.plist` from inline templates
#      with the current user's $HOME / project root substituted in.
#   2. `launchctl bootout`s any prior incarnation of those labels (so the
#      script is safe to re-run after a path change).
#   3. `launchctl bootstrap`s the freshly-written plists into the
#      `gui/$UID` domain so they start now AND on every login.
#
# After this runs the daemons are managed by launchd: KeepAlive=true means
# launchd respawns each one within ThrottleInterval seconds if it dies. That
# replaces the old `nohup ... &` lifecycle in `bin/brain-up`, which silently
# lost daemons to terminal-close / sleep-wake / unexplained crashes.
#
# Uninstall: `bin/brain-uninstall-launchd` (also called by `bin/brain-down`
# when the plists are loaded — see that script for the bootout shim).
#
# Env overrides:
#   BRAIN_LAUNCHD_DIR  (default: ~/Library/LaunchAgents) — where to write
#                       the .plist files. Tests point this at a tmp dir.
#   BRAIN_LAUNCHCTL    (default: launchctl on PATH) — interpreter to use
#                       for bootout/bootstrap. Tests stub this to capture
#                       calls without modifying the user's launchd state.

set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$( cd "$SCRIPT_DIR/.." && pwd )"

LAUNCHD_DIR="${BRAIN_LAUNCHD_DIR:-$HOME/Library/LaunchAgents}"
LAUNCHCTL="${BRAIN_LAUNCHCTL:-launchctl}"

mkdir -p "$LAUNCHD_DIR"

# Sanity: refuse to install if the wrappers don't exist yet — saves the
# user from a confusing launchd error when a half-finished checkout has
# the install script but not the wrappers.
for wrapper in "$SCRIPT_DIR/_brain-watcher-fg" "$SCRIPT_DIR/_brain-build-fg"; do
    if [[ ! -x "$wrapper" ]]; then
        echo "missing or non-executable wrapper: $wrapper" >&2
        echo "(did you forget to chmod +x or run from the wrong checkout?)" >&2
        exit 1
    fi
done

write_plist() {
    local label="$1"
    local wrapper="$2"
    local stdout_log="$3"
    local plist_path="$LAUNCHD_DIR/${label}.plist"

    # Heredoc with explicit ${HOME}/${PROJECT_ROOT} expansion. macOS
    # plists are XML; we keep the indentation flat so a future maintainer
    # can diff against `man launchd.plist` examples without squinting.
    cat >"$plist_path" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${label}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${wrapper}</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>${HOME}</string>
        <key>PATH</key>
        <string>${PROJECT_ROOT}/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>BRAIN_VAULT_PATH</key>
        <string>${BRAIN_VAULT_PATH:-${HOME}/brain-vault}</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>WorkingDirectory</key>
    <string>${PROJECT_ROOT}</string>
    <key>StandardOutPath</key>
    <string>${stdout_log}</string>
    <key>StandardErrorPath</key>
    <string>${stdout_log}</string>
</dict>
</plist>
EOF
    echo "wrote $plist_path"
}

reload_plist() {
    local label="$1"
    local plist_path="$LAUNCHD_DIR/${label}.plist"
    local domain="gui/$UID/${label}"

    # Bootout any prior incarnation. Suppress non-zero exit when the
    # service isn't currently loaded — that's the common idempotent case
    # on first install.
    "$LAUNCHCTL" bootout "$domain" 2>/dev/null || true

    if "$LAUNCHCTL" bootstrap "gui/$UID" "$plist_path"; then
        echo "loaded $domain (KeepAlive=true)"
    else
        echo "launchctl bootstrap failed for $domain" >&2
        return 1
    fi
}

write_plist com.brain.watcher "$SCRIPT_DIR/_brain-watcher-fg" /tmp/brain-watch.log
write_plist com.brain.build   "$SCRIPT_DIR/_brain-build-fg"   /tmp/brain-build.log

reload_plist com.brain.watcher
reload_plist com.brain.build

echo
echo '🧠 brain LaunchAgents installed:'
echo "   watcher → $LAUNCHD_DIR/com.brain.watcher.plist"
echo "   build   → $LAUNCHD_DIR/com.brain.build.plist"
echo '   uninstall: bin/brain-uninstall-launchd'
echo '   status:    bin/brain-status'
