#!/usr/bin/env bash
# Dev-checkout backcompat wrapper — delegates to the brain-up console script.
# Resolves the console script via the project venv (not PATH) to avoid an
# infinite-exec loop when bin/ appears before .venv/bin/ on PATH.
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
exec "$SCRIPT_DIR/../.venv/bin/brain-up" "$@"
