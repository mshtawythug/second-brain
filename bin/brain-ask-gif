#!/usr/bin/env bash
# brain-ask-gif — regenerate the CLI-reference "ask your corpus" GIF from
# docs/assets/ask.tape.
#
# Records the REGULAR `brain` CLI's `ask` flow — one `brain search` to show the
# corpus exists, then `brain ask "<question>" --explain` (plan → retrieve →
# reflect → synthesize, ending in a single cited answer) — against a THROWAWAY,
# fully-isolated Postgres this script provisions just for the recording and
# destroys afterward:
#
#   * compose project  brain-ask-gif          (NEVER the prod `brain` project)
#   * container        brain-ask-gif-postgres
#   * host port        55443                   (prod 55432, demo 55433, tests 5434)
#   * storage          a NAMED docker volume   (never a host bind-mount)
#   * database         second_brain_ask_gif
#
# Unlike search/show, `brain ask` ALWAYS needs a local Ollama CHAT model
# (llama3.1:8b by default — brain's ask/enrich model) for the plan/reflect/
# synthesize steps; the embedder is a separate concern (arctic if pulled, else
# the FTS-only `none` backend). This script preflights that the chat model is
# pulled and PRE-WARMS both the chat model and (when arctic) the embedding model
# off-camera with keep_alive=-1 so neither cold-loads during the recorded ask —
# the single biggest latency lever on a NUM_PARALLEL=1 host.
#
# The CLI is pointed at the sandbox purely through the environment
# (DATABASE_URL + BRAIN_HOME + BRAIN_VAULT_PATH), exported here and inherited by
# vhs. A dev checkout's repo-root .env would otherwise win and point the CLI at
# the PROD database, so every relevant var is overridden explicitly here, and the
# tape hard-aborts unless DATABASE_URL is the :55443 sandbox — a stray run can
# never touch personal data.
#
# All seeded content is synthetic (Larkspur compliance corpus; zero PII).
#
# Requires: vhs (brew install vhs — bundles ttyd + ffmpeg), Docker, and a local
# Ollama with the chat model pulled (`ollama pull llama3.1:8b`). ffmpeg (bundled
# with vhs) trims the long LLM "thinking" freeze out of the raw recording.
set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
REPO_ROOT="$( cd "$SCRIPT_DIR/.." && pwd )"
TAPE="docs/assets/ask.tape"
GIF="docs/assets/ask.gif"
MAX_BYTES=$(( 2560 * 1024 ))  # 2.5 MB CLI-reference budget for the ask GIF.

# --- Isolated-sandbox identifiers (kept distinct from prod/demo/test) -------
PROJECT="brain-ask-gif"
CONTAINER="brain-ask-gif-postgres"
DB_PORT="55443"
DB_NAME="second_brain_ask_gif"
DB_URL="postgresql://brain:brain@localhost:${DB_PORT}/${DB_NAME}"
PG_IMAGE="pgvector/pgvector:pg16"
# brain's default ask model (config DEFAULT_ENRICH_MODEL → ask_model). Override
# with BRAIN_ASK_MODEL to record against a different pulled chat model.
CHAT_MODEL="${BRAIN_ASK_MODEL:-llama3.1:8b}"
ARCTIC_MODEL="snowflake-arctic-embed2"

WORKDIR="${TMPDIR:-/tmp}/brain-ask-gif"
COMPOSE_FILE="$WORKDIR/docker-compose.ask-gif.yml"
NOTES_DIR="$WORKDIR/notes"
HOME_DIR="$WORKDIR/home"
VAULT_DIR="$WORKDIR/vault"
VOLUME_NAME="${PROJECT}_brain-ask-gif-pgdata"

usage() {
  echo "Usage: brain-ask-gif [-h|--help]  — record docs/assets/ask.tape into docs/assets/ask.gif via vhs against a throwaway :55443 Postgres sandbox (leaves nothing behind)."
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
esac

# --- Teardown: ALWAYS scoped to our own project, ALWAYS runs on exit --------
cleanup() {
  if [[ -f "$COMPOSE_FILE" ]]; then
    docker compose -p "$PROJECT" -f "$COMPOSE_FILE" down -v >/dev/null 2>&1 || true
  else
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    docker volume rm "$VOLUME_NAME" >/dev/null 2>&1 || true
  fi
  rm -rf "$WORKDIR" 2>/dev/null || true
}
trap cleanup EXIT

# --- Preflight --------------------------------------------------------------
if ! command -v vhs >/dev/null 2>&1; then
  echo "error: 'vhs' not found on PATH — install it with 'brew install vhs'" >&2
  echo "       (vhs bundles the ttyd + ffmpeg dependencies it needs)." >&2
  exit 1
fi
if ! command -v docker >/dev/null 2>&1; then
  echo "error: 'docker' not found on PATH — install Docker Desktop or Engine." >&2
  exit 1
fi
if ! command -v brain >/dev/null 2>&1; then
  echo "error: 'brain' not found on PATH — install it with 'pip install -e .'" >&2
  exit 1
fi
if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "error: 'ffmpeg' not found on PATH — it ships with vhs ('brew install vhs')." >&2
  exit 1
fi
if ! command -v ollama >/dev/null 2>&1; then
  echo "error: 'ollama' not found on PATH — 'brain ask' needs a local Ollama." >&2
  echo "       Install it (https://ollama.com) and 'ollama pull ${CHAT_MODEL}'." >&2
  exit 1
fi

cd "$REPO_ROOT"
[[ -f "$TAPE" ]] || { echo "error: tape not found: $REPO_ROOT/$TAPE" >&2; exit 1; }

# --- Ollama model preflight -------------------------------------------------
# The CHAT model is MANDATORY (ask can't synthesize without it); the embedding
# model is optional (we fall back to the FTS-only `none` backend without it).
# Capture the model list ONCE and grep here-strings: piping `ollama list` into
# `grep -q` races SIGPIPE under `set -o pipefail` (grep exits on first match and
# closes the pipe, so `ollama list` dies with 141 and the pipeline "fails" even
# on a match — nondeterministic false negatives).
ollama_models="$(ollama list 2>/dev/null || true)"
if [[ -z "$ollama_models" ]]; then
  echo "error: Ollama is not reachable — start it (e.g. 'brew services start ollama')." >&2
  exit 1
fi
if ! grep -qF "$CHAT_MODEL" <<<"$ollama_models"; then
  echo "error: chat model '${CHAT_MODEL}' is not pulled — 'brain ask' cannot run." >&2
  echo "       Pull it with: ollama pull ${CHAT_MODEL}" >&2
  echo "       (or point BRAIN_ASK_MODEL at a pulled chat model)." >&2
  exit 1
fi
if grep -qF "$ARCTIC_MODEL" <<<"$ollama_models"; then
  EMBEDDER="arctic"
else
  EMBEDDER="none"
fi
echo "Chat model: ${CHAT_MODEL}. Embedder for this recording: ${EMBEDDER}."

# --- Fresh workdir + synthetic seed corpus (zero PII) -----------------------
rm -rf "$WORKDIR"
mkdir -p "$NOTES_DIR" "$HOME_DIR" "$VAULT_DIR"

cat > "$COMPOSE_FILE" <<YAML
services:
  postgres:
    image: ${PG_IMAGE}
    container_name: ${CONTAINER}
    environment:
      POSTGRES_USER: brain
      POSTGRES_PASSWORD: brain
      POSTGRES_DB: ${DB_NAME}
    ports:
      - "${DB_PORT}:5432"
    volumes:
      - brain-ask-gif-pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U brain -d ${DB_NAME}"]
      interval: 2s
      timeout: 3s
      retries: 30

volumes:
  brain-ask-gif-pgdata:
YAML

# --- Point the CLI at the sandbox purely through the environment ------------
# Exported here → inherited by vhs → inherited by the recorded shell. Overriding
# DATABASE_URL in the process env makes it win over any repo-root .env (which is
# resolved via os.environ.setdefault and therefore never clobbers a value that
# is already set — see src/brain/config.py).
export DATABASE_URL="$DB_URL"
export BRAIN_HOME="$HOME_DIR"
export BRAIN_VAULT_PATH="$VAULT_DIR"
export BRAIN_EMBEDDER="$EMBEDDER"
export BRAIN_GRAPH_ENABLED="false"
export ASK_GIF_WORK_DIR="$HOME_DIR"
# Skip the post-ingest Ollama auto-summary during the off-camera seed: it would
# force a chat-model round-trip per doc and, on a NUM_PARALLEL=1 host, thrash the
# arctic↔chat model swap. The recorded ask still exercises the chat model for
# real; the seed only needs embeddings (or FTS with `none`).
export BRAIN_ENRICH_MIN_TOKENS="1000000"
# Keep both models resident in VRAM across the recording so the on-camera ask
# never pays a cold-load. -1 = "never unload" (see config.keep_alive_wire_value).
export BRAIN_OLLAMA_KEEP_ALIVE="-1"

# --- Provision the throwaway Postgres (fresh every run) ---------------------
echo "Provisioning the throwaway ask-gif Postgres on port ${DB_PORT} …"
docker compose -p "$PROJECT" -f "$COMPOSE_FILE" down -v >/dev/null 2>&1 || true
docker compose -p "$PROJECT" -f "$COMPOSE_FILE" up -d >/dev/null

echo "Waiting for Postgres to accept connections …"
ready=""
for _ in $(seq 1 30); do
  if docker exec "$CONTAINER" pg_isready -U brain -d "$DB_NAME" >/dev/null 2>&1; then
    ready="yes"; break
  fi
  sleep 2
done
[[ -n "$ready" ]] || { echo "error: ${CONTAINER} never became ready" >&2; exit 1; }

# --- Seed the synthetic corpus (all off camera) -----------------------------
echo "Applying migrations + seeding the synthetic corpus …"
brain init >/dev/null

# Ingest one synthetic doc with a chosen source kind so the ask "Sources" list
# shows realistic, varied provenance (manual / slack / gmail). Body arrives on
# stdin; --no-enrich keeps the seed a fast embed-only op.
seed() {
  local source="$1" external_id="$2" title="$3" ctype="$4" date="$5"
  brain ingest-stdin --source "$source" --external-id "$external_id" \
    --title "$title" --content-type "$ctype" --date "$date" --no-enrich \
    --tag compliance >/dev/null
}

seed manual ask-note-0001 "SOC 2 evidence automation plan" note 2026-06-03 <<'NOTE'
The plan to stop reconstructing SOC 2 evidence the night before fieldwork. Every
access review, change approval, and backup test already emits a signal we never
captured in one place. A weekly job snapshots each signal, timestamps it, and
files it in the auditor portal, so evidence becomes a byproduct of the work
instead of a quarterly fire drill. Target: generate at least half of the forty
audit artifacts automatically before the observation window opens.
NOTE

seed slack ask-slack-0002 "#compliance — evidence automation idea" message 2026-06-03 <<'NOTE'
sam.rivera: idea I can't shake — most of our audit pain is evidence collection,
so what if we automated it end to end?
sam.rivera: every access review, every change approval, every backup test already
emits a signal. we just don't capture it in one place.
sam.rivera: imagine a job that snapshots the evidence weekly, timestamps it, and
drops it in the portal auditors already use. no human chasing screenshots.
sam.rivera: evidence stops being a fire drill and becomes a byproduct of the work,
and it kills the number-one auditor follow-up: inconsistent or undated artifacts.
NOTE

seed slack ask-slack-0003 "#compliance — weekly standup notes" message 2026-06-01 <<'NOTE'
