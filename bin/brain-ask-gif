NOTE

seed manual ask-note-0009 "Audit season retro — lessons learned" note 2026-06-15 <<'NOTE'
What I want to carry forward from audit season. The single biggest lever was
evidence automation — the moment collecting evidence became a byproduct of doing
the work instead of a quarterly fire drill, the whole program relaxed. Second
lever: ownership. Every control, cert, and job that caused pain this year did so
because nobody owned it, and naming an owner is the cheapest compliance upgrade
we have. The throughline across every meeting and thread this cycle is the same:
compliance is not a document you produce at the end, it is a set of habits you
maintain all year.
NOTE

# --- Pre-warm Ollama off camera --------------------------------------------
# Load the chat model (and the arctic embedder when active) into VRAM with
# keep_alive=-1 so the recorded `brain ask` runs fully warm — no cold-load
# latency spike races the fixed vhs Sleep. A single throwaway chat call is
# enough to resident the model; the embed call residents arctic in parallel.
echo "Pre-warming Ollama (${CHAT_MODEL}${EMBEDDER:+ + $EMBEDDER}) …"
if [[ "$EMBEDDER" == "arctic" ]]; then
  curl -s "${OLLAMA_HOST:-http://localhost:11434}/api/embed" \
    -d "{\"model\":\"${ARCTIC_MODEL}\",\"input\":\"warmup\",\"keep_alive\":-1}" \
    >/dev/null 2>&1 || true
fi
curl -s "${OLLAMA_HOST:-http://localhost:11434}/api/chat" \
  -d "{\"model\":\"${CHAT_MODEL}\",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":\"warmup\"}],\"keep_alive\":-1}" \
  >/dev/null 2>&1 || true

# --- Record -----------------------------------------------------------------
echo "Recording $TAPE with vhs …"
vhs "$TAPE"

[[ -f "$GIF" ]] || { echo "error: vhs did not produce $GIF" >&2; exit 1; }

# --- Trim the long static stretches -----------------------------------------
# `brain ask` prints nothing until the plan→retrieve→reflect→synthesize loop
# finishes (~20s warm), so the raw recording (a) holds a static prompt for the
# full think time, then (b) holds the finished answer for whatever is left of the
# fixed vhs Sleep — both look long and their lengths swing with LLM speed.
#
# The LONGEST freeze is always the think-time: the shell is busy, so nothing
# moves (freezedetect finds it cleanly on the pristine gif). Its END is exactly
# where the answer renders. So we (a) drop the think body, keeping KEEP_THINK
# seconds of "question typed, working…", and (b) drop the ENTIRE trailing hold
# after KEEP_ANSWER seconds of the answer — the answer hold itself is NOT a
# freeze (the returned prompt blinks a cursor), so it must be cut by position,
# not by freeze detection. Both windows drop in a SINGLE re-encode; `dither=none`
# keeps terminal text crisp (no gradients to band). A no-op when no think freeze
# is found, so it never corrupts an already-short clip.
echo "Trimming the long static stretches out of the recording …"
FREEZE_LOG="$WORKDIR/freeze.log"
ffmpeg -hide_banner -nostats -i "$GIF" \
  -vf "freezedetect=n=-55dB:d=2" -map 0:v:0 -f null - 2>"$FREEZE_LOG" || true

# awk over the freezedetect metadata (value is always the trailing field): emit
# "think_start think_dur" for the single LONGEST freeze, or "0 0" if none clears
# a sane minimum. No fragile bash arithmetic.
KEEP_THINK="2.5"    # seconds of "working…" kept before cutting to the answer
KEEP_ANSWER="3.2"   # seconds of the finished answer kept before the loop restarts
read -r think_start think_dur <<EOF
$(awk '
    /lavfi.freezedetect.freeze_start:/    { s = $NF }
    /lavfi.freezedetect.freeze_duration:/ { d = $NF; if (s != "" && d > best) { best = d; bs = s }; s = "" }
    END { if (best > 3.0) printf "%.3f %.3f\n", bs, best; else print "0 0" }
  ' "$FREEZE_LOG")
EOF

# Build the drop expression: the think body, then everything past the answer
# read-pause. total = gif duration (upper bound of the tail cut).
drop=""
if awk "BEGIN{exit !(${think_dur:-0} > $KEEP_THINK + 1.0)}"; then
  total="$( ffprobe -v error -show_entries format=duration -of csv=p=0 "$GIF" | head -1 )"
  think_end="$( awk "BEGIN{printf \"%.3f\", $think_start + $think_dur}" )"
  body_start="$( awk "BEGIN{printf \"%.3f\", $think_start + $KEEP_THINK}" )"
  body_end="$( awk "BEGIN{printf \"%.3f\", $think_end - 0.1}" )"
  tail_start="$( awk "BEGIN{printf \"%.3f\", $think_end + $KEEP_ANSWER}" )"
  drop="between(t,${body_start},${body_end})"
  echo "  · collapsing the ${think_dur}s think freeze → keeping ${KEEP_THINK}s head"
  if awk "BEGIN{exit !($total > $tail_start + 0.2)}"; then
    drop="${drop}+between(t,${tail_start},${total})"
    echo "  · cutting the trailing answer hold → keeping ${KEEP_ANSWER}s of the answer"
  fi
fi

if [[ -n "$drop" ]]; then
  src_fps="$( ffprobe -v error -select_streams v:0 -show_entries stream=avg_frame_rate \
              -of csv=p=0 "$GIF" | head -1 )"
  [[ "$src_fps" == */* && "${src_fps#*/}" != "0" ]] || src_fps="50/1"
  TRIMMED="$WORKDIR/ask-trimmed.gif"
  PALETTE="$WORKDIR/palette.png"
  SEL="select='not(${drop})',setpts=N/FRAME_RATE/TB,fps=${src_fps}"
  ffmpeg -hide_banner -nostats -i "$GIF" -vf "${SEL},palettegen=stats_mode=full" -y "$PALETTE" >/dev/null 2>&1
  ffmpeg -hide_banner -nostats -i "$GIF" -i "$PALETTE" \
    -lavfi "${SEL}[x];[x][1:v]paletteuse=dither=none" -y "$TRIMMED" >/dev/null 2>&1
  if [[ -s "$TRIMMED" ]]; then
    mv "$TRIMMED" "$GIF"
    echo "Collapsed the long static stretches."
  else
    echo "warning: freeze trim produced an empty file — keeping the untrimmed GIF." >&2
  fi
else
  echo "note: no long static stretch detected — keeping the recording as-is."
fi

# stat is BSD (macOS) vs GNU (Linux); try both invocations.
bytes="$( stat -f%z "$GIF" 2>/dev/null || stat -c%s "$GIF" )"
human="$( awk -v b="$bytes" 'BEGIN { printf "%.2f MB", b / 1048576 }' )"

echo "Wrote $GIF ($human, $bytes bytes)."
if (( bytes > MAX_BYTES )); then
  echo "warning: $GIF exceeds the 2.5 MB CLI-reference budget — tune the tape's" >&2
  echo "         FontSize/framerate/Sleep durations to shrink it." >&2
fi
