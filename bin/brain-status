#!/usr/bin/env bash
# Dev-checkout backcompat wrapper — delegates to the brain-status console script.
# The console script (brain.bin.status:main) is registered in pyproject.toml and
# available after `pip install -e .` or `pipx install .`.
#
# Requires the project venv to be activated OR brain-status on PATH (e.g. via
# `pipx ensurepath`).
exec brain-status "$@"
