#!/usr/bin/env bash
# Dev-checkout backcompat wrapper — delegates to the brain-rebuild console script.
# The console script (brain.bin.rebuild:main) is registered in pyproject.toml and
# available after `pip install -e .` or `pipx install .`.
#
# Requires the project venv to be activated OR brain-rebuild on PATH (e.g. via
# `pipx ensurepath`).
exec brain-rebuild "$@"
