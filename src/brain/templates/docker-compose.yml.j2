# Jinja variables: brain_home, pg_port
name: brain
services:
  postgres:
    # Custom PG16 image: pgvector 0.8.2 + pgcrypto + Apache AGE 1.5.0-rc0 (GraphRAG).
    # `brain setup` materializes the packaged Dockerfile into
    # {{ brain_home }}/docker/age/Dockerfile before `docker compose up`, so this
    # build stanza resolves on fresh installs.
    build:
      context: {{ brain_home }}/docker/age
      dockerfile: Dockerfile
    image: second-brain-age:pg16-v1.5.0-rc0-pgv0.8.2
    container_name: second-brain-postgres
    environment:
      POSTGRES_USER: brain
      POSTGRES_PASSWORD: brain
      POSTGRES_DB: second_brain
    ports:
      - "{{ pg_port }}:5432"
    volumes:
      - {{ brain_home }}/data/postgres:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U brain -d second_brain"]
      interval: 5s
      timeout: 3s
      retries: 10
