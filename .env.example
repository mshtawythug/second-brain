# Embedder backend: arctic (default, free, local) | voyage (paid SaaS)
#                   | qwen3 (free, local, China-origin)
BRAIN_EMBEDDER=arctic

# Ollama (required for arctic + qwen3; install: brew install ollama && brew services start ollama)
#   For arctic: ollama pull snowflake-arctic-embed2
#   For qwen3:  ollama pull qwen3-embedding:8b
OLLAMA_HOST=http://localhost:11434
QWEN3_MODEL=qwen3-embedding:8b

# Voyage AI (required only when BRAIN_EMBEDDER=voyage)
# VOYAGE_API_KEY=

# Local Postgres (Docker)
# DATABASE_URL → prod on the stock pgvector image, port 55432
# (docker-compose.yml, ./data/postgres bind-mount). The Apache AGE cutover of
# the prod container is gated — see docs/specs/2026-05-20-graphrag-age-image.md.
DATABASE_URL=postgresql://brain:brain@localhost:55432/second_brain

# Vault folder (default: ~/brain-vault). Override to point elsewhere — e.g.
# ~/Documents/brain-vault for iCloud-friendly sync on macOS.
# BRAIN_VAULT_PATH=

# Owner email — used by the email-thread reading mode (P4.4) to power the
# "Show only my replies" filter on `_ingested/gmail/<thread>/` pages. The
# Quartz build reads this at build time and bakes it into rendered pages
# as `window.BRAIN_USER_EMAIL`. Leave unset to render the toggle without
# a user identity (the filter matches nothing).
# BRAIN_USER_EMAIL=you@example.com

# Comma-separated list of identifiers (emails AND/OR display names) that
# count as the corpus owner. Stripped from participant_keys before
# derived-edge rules R2 (shared_participant) and R3 (same_day_participant)
# evaluate, so a meeting/email isn't linked to every other doc the owner
# is on. Both forms accepted; matching is case-insensitive (entries are
# trimmed + lowercased at load time). Leave unset for the default
# behaviour (no stripping).
# Example: BRAIN_OWNER_PARTICIPANTS="Pat Owner,redacted@example.com,redacted@example.com"
# BRAIN_OWNER_PARTICIPANTS=

# Recency boost half-life in days. After RRF, each document's score is
# multiplied by 0.5 ** (age_days / halflife_days) where age_days comes from
# coalesce(sent_at, ingested_at). Default 180 days. Set to a very large value
# (e.g. 999999) to effectively disable the boost. Must be a positive float.
# BRAIN_RECENCY_HALFLIFE_DAYS=180

# Snippet-context expansion budget (tokens). After the best-matching chunk is
# identified, this many tokens of neighboring-chunk context are stitched
# around it to give richer reading context. Default 200. Set to 0 to use the
# legacy single-chunk snippet. Must be a non-negative integer.
# BRAIN_SNIPPET_CONTEXT_TOKENS=200

# Hard outer character cap on a stitched search snippet. Default 1600 (exactly
# the 4 x SNIPPET_LENGTH constant this replaced, so the default is numerically
# unchanged). Applies to CLI and MCP alike.
#
# THIS, NOT THE BUDGET ABOVE, IS USUALLY THE BINDING CONSTRAINT. Measured on
# the live corpus 2026-08-13 (11 queries x 5 results = 55 results): on 47 of 55
# (85.5%) the MATCHED CHUNK ALONE already reached this cap, so it truncates
# before neighbouring context is ever consulted; only 3 of 55 admitted any
# neighbour at all (median chunk ~570 tokens vs a 200-token budget). The cap
# discards 11,514 of 30,727 produced snippet tokens (37.5%) unread.
#
# So: if snippets feel cut off, raise THIS first — raising
# BRAIN_SNIPPET_CONTEXT_TOKENS alone will usually change nothing. Raising it
# lengthens every snippet in every result, which an agent pays for in context.
# This is also the rollback lever for the 37.5% discard above.
#
# Positive integer. 0 is REJECTED with a ConfigError at startup (unlike
# BRAIN_SHOW_MAX_CONTENT_TOKENS, where 0 means unlimited) — set a large value
# instead. Full write-up: brain.snippet_context's module docstring;
# re-measure with scripts/token_payload_report.py --snippet-constraints.
# BRAIN_SNIPPET_MAX_CHARS=1600

# --- brain resurface (spaced-repetition resurfacing, Plan 02) ---------------
# Default number of docs `brain resurface` surfaces per run (--limit override).
# Integer >= 1. Default 7.
# BRAIN_RESURFACE_LIMIT=7

# Exclude docs younger than N days from the resurface queue (--min-age-days
# override). Brand-new notes don't need resurfacing. Integer >= 0. Default 14.
# BRAIN_RESURFACE_MIN_AGE_DAYS=14

# Half-life (days) for the age factor: at this age a doc's age_factor is 0.5,
# saturating toward 1.0 for older docs (older = higher review priority). Reuses
# the search recency decay shape, inverted. Positive float. Default 180.
# BRAIN_RESURFACE_AGE_HALFLIFE_DAYS=180

# Half-life (days) for access staleness: a doc last opened this many days ago
# contributes 0.5; opened-today scores near 0, never-opened near 1. Shorter
# than the age half-life so a recent open visibly deprioritizes. Positive
# float. Default 90.
# BRAIN_RESURFACE_ACCESS_HALFLIFE_DAYS=90

# How long Ollama keeps a model in VRAM between requests. Passed as
# keep_alive in every outgoing Ollama HTTP call (embed, chat, generate).
# "30m" keeps the model hot across typical ingest/search bursts. Accepts a
# positive integer duration string ("30m", "1h", "60s"), a bare positive
# integer seconds ("60"), "-1" (keep loaded indefinitely), or "0" (unload
# immediately). Other malformed values ("-2", "-1m", "abc") are rejected at
# startup. Raise to "1h" for longer idle gaps — or, on a machine dedicated to
# the brain, set "-1" to keep the model resident forever: this eliminates the
# measured 5,028ms first-embed latency cliff that hits after the model has been
# idle past the keep_alive window (a cold reload). The shipped default stays
# "30m" so machines that share the GPU with other workloads free VRAM on idle.
# BRAIN_OLLAMA_KEEP_ALIVE=30m

# Enrichment model (Ollama) for auto-summary + auto-tags. Default
# llama3.1:8b. Override for higher quality (gemma3:27b — ~60s/doc on M1 Pro,
# best summarization in the non-Chinese open-weight space) or higher speed
# (llama3.2:3b — ~4s/doc, looser tags). Switching models causes
# `brain enrich --backfill` to re-enrich all docs whose summary_model no
# longer matches the current setting.
# BRAIN_ENRICH_MODEL=llama3.1:8b

# Enrichment HTTP timeout in seconds. Default 60. Raise when running a
# larger model (gemma3:27b / phi4:14b / mistral-small) — cold-load + long
# inputs can exceed 60s on Apple Silicon.
# BRAIN_ENRICH_TIMEOUT_SECONDS=60

# Minimum input tokens before a doc is enriched. Docs shorter than this
# skip enrichment (a 1-paragraph note doesn't benefit from a summary).
# Default 50. Set to 0 to enrich every doc.
# BRAIN_ENRICH_MIN_TOKENS=50

# Maximum input tokens fed to the enricher. Long docs are head-truncated to
# this many tokens before the summary prompt is sent. Default 1200 (~900
# words, the doc head — enough for a 2-3 sentence summary at ~2.5s/doc on
# M-series silicon). Raise to 4000 for higher fidelity on long transcripts
# at ~7s/doc.
# BRAIN_ENRICH_MAX_INPUT_TOKENS=1200

# --- GraphRAG (Apache AGE entity graph) --------------------------------------
# Default-ON entity-graph sync alongside the vector/hybrid search. `brain setup`
# provisions a Postgres image that ships Apache AGE; the committed
# docker-compose.yml in the repo root stays on stock pgvector and operators flip
# to AGE via a local docker-compose.override.yml — see
# docs/specs/2026-05-20-graphrag-age-image.md. On a stock pgvector DB the graph
# stack auto-degrades to a no-op (init prints "graph skipped — AGE not
# available"; ingest's graph sync is best-effort and never raises). Names match
# the design spec §10.

# Enable the people-aspect graph sync hook. When true AND the DB ships Apache
# AGE, every ingest/edit/delete keeps the people graph in lock-step with the
# documents table; on a stock pgvector DB the sync is a best-effort no-op
# (silent no-op when AGE is absent; logged + dropped if AGE is present but reconcile raises). Accepts 1/true/yes/on or 0/false/no/off.
# Default true (the brain setup template provisions an AGE-capable image).
# Set to false to disable graph sync at ingest time.
# BRAIN_GRAPH_ENABLED=true

# Tenant id stamped on every graph row/vertex/edge and every query. Single-user
# local deployments leave this at the default. Default "default".
# BRAIN_GRAPH_TENANT=default

# Co-occurrence sliding-window radius (inclusive, unit-agnostic). For the people
# aspect every participant shares one notional position, so any window >= 1
# yields the complete graph over a document's persons. Positive integer.
# Default 3.
# BRAIN_GRAPH_COOCCUR_WINDOW=3

# Per-document entity cap — bounds the O(pairs) co-occurrence work on an
# entity-dense document. A positive integer, or "none"/"unlimited" to disable
# the cap. Default 40.
# BRAIN_GRAPH_MAX_ENTITIES_PER_DOC=40

# Generic-entity document-frequency ratio. An entity appearing in more than
# round(ratio * tenant_corpus_N) documents is treated as generic and its edges
# are suppressed at derive time. A float in (0.0, 1.0]. Changing it forces a
# corpus-wide re-derive — run `brain graphrag refresh`. Default 0.30.
# BRAIN_GRAPH_GENERIC_DF=0.30

# --- GraphRAG concept extraction + retrieval ---------------------------------
# Names match the design spec §10. The concept extractor v2 passed its eval
# gate (f1 ~0.88 on the local eval set) so the aspect is default-ON.

# Enable the concept aspect (LLM entity extraction over topics/projects/orgs/
# tools) alongside the always-on people aspect. Requires
# BRAIN_GRAPH_EXTRACT_MODEL to be pullable via `ollama pull <name>` (default
# llama3.1:8b — ~4.7 GB). Set to false to disable concept extraction (people
# aspect still works without an LLM). Default true.
# BRAIN_GRAPH_CONCEPTS=true

# Ollama model for the concept entity extractor. Any model pullable via
# `ollama pull <name>` that supports JSON-mode output. Default llama3.1:8b.
# BRAIN_GRAPH_EXTRACT_MODEL=llama3.1:8b

# Concept-extractor input head cap (tiktoken tokens). The document body is
# truncated to its first N tokens BEFORE chunking, bounding the per-document LLM
# call count for very long documents. A positive integer, or 0/"none"/"unlimited"
# to disable (extract the whole document). Changing it bumps the extractor
# version, so a
# `brain graphrag build --backfill --concepts` re-extracts. Default 8000.
# BRAIN_GRAPH_EXTRACT_MAX_INPUT_TOKENS=8000

# Bounded traversal radius for local/themes retrieval (variable-length hops).
# Positive integer. Default 2.
# BRAIN_GRAPH_DEPTH=2

# Frontier cap — max entities reached per seed during traversal. Positive
# integer. Default 200.
# BRAIN_GRAPH_FRONTIER_CAP=200

# Per-node expansion fan-out cap during traversal. Positive integer. Default 50.
# BRAIN_GRAPH_MAX_DEGREE=50

# Minimum normalized-lift edge weight admitted into a traversal. A float in
# [0.0, 1.0]; 0.0 admits every edge. Default 0.20.
# BRAIN_GRAPH_MIN_EDGE_WEIGHT=0.20

# Number of ranked theme groups returned by "themes with X". Positive integer.
# Default 5.
# BRAIN_GRAPH_THEME_LIMIT=5

# --- GraphRAG global communities (wave G3) -----------------------------------
# Parsed in wave G3; consumed by `brain graphrag communities build|refresh`
# (networkx Louvain over the tenant entity graph) and the global retrieval path.
# §17c pins the migration-013 schema + perf budgets but NOT these tuning
# defaults — the values below are chosen to be consistent with the other graph
# knobs.

# Louvain resolution. Higher values yield more, smaller communities; lower
# values yield fewer, larger ones. Positive float. Default 1.0 (networkx
# default).
# BRAIN_GRAPH_COMMUNITY_RESOLUTION=1.0

# RNG seed for deterministic Louvain detection (so repeated builds over an
# unchanged graph produce stable communities). Non-negative integer.
# Default 1234.
# BRAIN_GRAPH_COMMUNITY_SEED=1234

# Minimum members for a community to be materialized — smaller communities are
# dropped. Positive integer. Default 3.
# BRAIN_GRAPH_COMMUNITY_MIN_SIZE=3

# Jaccard overlap threshold for stable-identity matching across rebuilds: a new
# community whose member set overlaps an old one by >= this fraction reuses the
# old community_key. A float in [0.0, 1.0]. Default 0.5.
# BRAIN_GRAPH_COMMUNITY_JACCARD=0.5

# Number of ranked communities returned by the global retrieval mode. Positive
# integer. Default 5.
# BRAIN_GRAPH_COMMUNITY_LIMIT=5

# Ops safety cap on the number of communities materialized per tenant per build
# (bounds the summary + embedding cost). A positive integer, or "none"/
# "unlimited" to disable. Default none (unlimited).
# BRAIN_GRAPH_COMMUNITY_MAX=none

# Extra automated-sender denylist for person extraction (Phase 1 data-quality
# remediation). Comma-separated substrings or full addresses, layered on top of
# the always-on generic heuristic (no-reply / noreply / notifications / mailer /
# bounce / postmaster / …). A directory entry whose email contains any listed
# token never becomes a person — in the graph OR the People Hub. Keep entries
# generic; the heuristic already covers the common automated patterns. Empty by
# default (generic heuristic only).
# BRAIN_GRAPH_SENDER_DENYLIST=alerts@,billing@example.com

# --- Plan 07: brain connect (proactive auto-link suggestions) ---------------
# Confidence floor for a suggestion to be persisted by `brain connect refresh`.
# The blended score is the mean of the graph + embedding affinity legs (absent
# leg counts as 0), in [0, 1]. A float in (0.0, 1.0]. Default 0.60.
# BRAIN_CONNECT_MIN_SCORE=0.60

# Per-source-doc cap on candidate targets pulled from EACH affinity leg before
# the blend. Positive integer. Default 50.
# BRAIN_CONNECT_CANDIDATE_LIMIT=50

# Max suggestions persisted per source doc after gating + ranking. Positive
# integer. Default 5.
# BRAIN_CONNECT_MAX_PER_DOC=5
# --- brain ask (agentic answer synthesis, Plan 06) ---------------------------
# Hard cap on plan/retrieve/reflect loop iterations (positive int). Default 3 —
# the initial plan plus up to two reflect-driven follow-up rounds. Lower it to
# trade thoroughness for speed; `brain ask --no-loop` skips the loop entirely.
# BRAIN_ASK_MAX_ITERATIONS=3

# Max documents retrieved per sub-query per iteration (positive int). Default 5,
# mirroring `brain search --limit`. Overridable per call via `--limit`.
# BRAIN_ASK_DOCS_PER_ITER=5

# Ollama model for the ask plan/reflect/synthesize chat steps. Blank/unset
# inherits BRAIN_ENRICH_MODEL (default llama3.1:8b) so ask reuses the configured
# chat model; set this only to use a different model for synthesis.
# BRAIN_ASK_MODEL=llama3.1:8b

# Per-call HTTP timeout (seconds) for each ask chat step (positive float).
# Default 90 — headroom for a cold-model swap-in on the first call plus the
# longer synthesize completion.
# BRAIN_ASK_TIMEOUT_SECONDS=90
# --- brain audio (NotebookLM-style two-host overview, Plan 04) ----------------
# `brain audio` turns a GraphRAG theme/community bundle into a two-host podcast
# script (.json + .md), optionally synthesized to audio via a pluggable
# `--tts shell:<command>` backend. Requires BRAIN_GRAPH_ENABLED=true + a built
# graph (`brain graphrag build`; plus `brain graphrag communities build` for
# --topic).

# Ollama model used to generate the dialogue (kept independent of the enrich /
# extract models). Non-empty string. Default llama3.1:8b.
# BRAIN_AUDIO_SCRIPT_MODEL=llama3.1:8b

# Max speaker turns in the generated dialogue. A POSITIVE EVEN integer (pairs of
# Host/Guest); surplus turns the model emits are truncated. Default 12.
# BRAIN_AUDIO_MAX_TURNS=12

# Max prompt tokens (tiktoken cl100k_base) fed to the script generator. The
# bundle (entity names + summaries — never raw document bodies) is trimmed
# group-by-group to fit this budget. Positive integer. Default 3000.
# BRAIN_AUDIO_MAX_INPUT_TOKENS=3000

# Max theme / community groups pulled from the graph context into the source
# bundle. Positive integer. Default 4.
# BRAIN_AUDIO_THEME_LIMIT=4

# --- Plan 08: brain gaps (search-failure knowledge-gap detection) -----------
# Default mining window (days) over the search_queries log for the CLI surfaces
# `brain gaps` / `brain gaps push` — applied when --since is omitted. The MCP
# brain_gaps tool takes an explicit since_days argument instead (default 30 per
# its signature) and does not read this knob. Positive integer. Default 30.
# BRAIN_GAPS_LOOKBACK_DAYS=30

# Minimum query-occurrence count before a failed-query cluster surfaces as a
# search_failure gap. Used by the detector on every push path (CLI + MCP).
# Positive integer. Default 2.
# BRAIN_GAPS_MIN_CLUSTER_SIZE=2

# --- Wave 3: MCP payload ceilings -------------------------------------------
# Six bounds on how much ONE MCP response may cost an agent's context window.
# They are enforced on the MCP tool surface only — no `brain` CLI command is
# capped by them (you can pipe and page; an agent pays for the whole payload
# before it can see the size). None of them truncates silently: each either
# raises with the ceiling named or returns an explicit marker.
#
# THESE ARE THE ROLLBACK MECHANISM. To restore pre-Wave-3 behaviour without a
# deploy, raise the relevant knob to a very large value. Note that only
# BRAIN_SHOW_MAX_CONTENT_TOKENS accepts 0 — the other five are validated as
# >= 1 and reject 0 with a ConfigError at startup, so "set it to 0" is NOT a
# universal opt-out. (The one exception to knob-based rollback is
# `brain_graphrag_entities`' `limit=0` re-mapping, which is a code path.)

# Max tokens of the document body AND of the `summary` returned by MCP
# `brain_show` — one knob, applied to both fields, on every path (not only
# under summary_only=true). The largest live document MEASURED (2026-08-13,
# read-only on prod) at 67,410 tokens — do NOT "correct" that to 74,258, an
# audit figure that did not survive re-measurement (see src/brain/config.py).
# The p95 body is ~14.7k tokens (~58,900 chars), so the default leaves typical
# documents untouched and caps the tail.
#
# BOUND HONESTLY: a payload carrying a truncated body AND a truncated summary
# is bounded by 2x this value, not by this value. That is the price of one knob
# instead of two; size a context window against twice this number. The summary
# gained a ceiling because summary_only=true — the escape hatch FROM the body
# ceiling — previously returned an unbounded field (migration 011 declares
# documents.summary as TEXT; it is short only because OllamaEnricher writes it
# that way). Full write-up: docs/configuration.md, the
# BRAIN_SHOW_MAX_CONTENT_TOKENS note.
#
# 0 = unlimited (the ONLY knob here for which 0 is legal); it opts BOTH fields
# out. Non-negative integer. Default 25000.
# BRAIN_SHOW_MAX_CONTENT_TOKENS=25000

# Ceiling on MCP `brain_search`'s `limit`. Equals brain.search.CANDIDATE_LIMIT
# — above it a larger limit cannot produce more documents anyway. A larger
# request is rejected with INVALID_PARAMS naming the ceiling. Positive integer.
# Default 50.
# BRAIN_SEARCH_MAX_LIMIT=50

# Ceiling on MCP `brain_recall`'s `budget_tokens`. NOT 32000: the payload ships
# every passage twice (structured + rendered), delivering ~2.2x the budget
# requested, so the accepted budget is ~32000/2.36. See docs/configuration.md
# §"BRAIN_RECALL_MAX_BUDGET_TOKENS — why 13000 and not 32000". Must be >=
# BRAIN_RECALL_BUDGET_TOKENS (cross-validated at startup). Positive integer.
# Default 13000.
# BRAIN_RECALL_MAX_BUDGET_TOKENS=13000

# Ceiling on MCP `brain_graphrag_entities`' `limit`. The live graph's 6,589
# entities serialize to 246,724 tokens, so the old `limit=0 == all` was
# re-mapped to this ceiling — the one genuinely breaking semantic in the wave.
# Positive integer. Default 500 (~17.7k tokens; the default limit of 50 is
# ~1.8k).
# BRAIN_GRAPH_ENTITIES_MAX_LIMIT=500

# Row cap for the three MCP list tools (`brain_backlinks` / `brain_links` /
# `brain_orphans`), which previously had no limit at all. Covers the live
# maximum outgoing-link count (166) without special-casing. A cut list carries
# `more_available: true` on its last element. Positive integer. Default 200.
# BRAIN_MCP_ROWS_MAX_LIMIT=200

# Default AND ceiling for MCP `brain_graphrag_communities`' `limit`, whose
# default used to be "all". Deliberately NOT BRAIN_GRAPH_COMMUNITY_LIMIT (5)
# above, which governs retrieval-time global theme selection — overloading a
# ranking knob for an admin listing would couple the two. Positive integer.
# Default 25.
# BRAIN_GRAPH_COMMUNITIES_LIST_LIMIT=25

# ── Development ──────────────────────────────────────────────────────────────
# TEST_DATABASE_URL → the SEPARATE Apache-AGE test instance on port 5434
# (docker-compose.age-test.yml, named volume), so the suite runs against the
# PG16 + pgvector 0.8.2 + pgcrypto + Apache AGE 1.5.0-rc0 superset image.
# Start it: docker compose -f docker-compose.age-test.yml up -d --build
TEST_DATABASE_URL=postgresql://brain:brain@localhost:5434/second_brain_test
