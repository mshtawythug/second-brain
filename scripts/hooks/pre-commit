#!/usr/bin/env bash
#
# pre-commit PII / secret gate.
#
# Blocks a commit whose STAGED, ADDED lines contain real personal data, real
# customer/employer/company names, internal project codenames, secrets, or real
# transcript/email content. Wired via `git config core.hooksPath scripts/hooks`.
#
# Two lists (see scripts/hooks/README.md):
#   .pii-allowlist.txt        (committed)   — public/synthetic tokens to IGNORE in
#                                             the SEMANTIC pass. FALSE POSITIVES
#                                             ONLY. NEVER real PII.
#   .pii-denylist.local.txt   (gitignored)  — your REAL sensitive terms to ALWAYS
#                                             block. Ships .pii-denylist.local.txt.example.
#
# Bypass consciously (only when you are certain the diff is clean):
#   git commit --no-verify
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
allowlist="${repo_root}/.pii-allowlist.txt"
denylist="${repo_root}/.pii-denylist.local.txt"

# --- 0. Lint + type gate (runs FIRST: cheapest, most deterministic) ---------
#
# Why this is here and not only in CI: on 2026-08-05 SIX undefined-name defects
# landed in one session, and every one of them reached another teammate's gate
# run before its author noticed — a circular import that broke `import
# brain.ingest` (so NO pytest run in the repo could collect), plus five
# NameErrors. CI catches them eventually; by then they have already cost
# somebody else a debugging cycle. Local-first is what stops that.
#
# BOTH tools, as separate steps with distinct messages, because neither is
# sufficient alone — measured on those six:
#   5 caught by `ruff check` (F821 undefined name)
#   1 caught ONLY by `mypy`  (routes_search.py:57, inside security-relevant code)
#   0 caught by any runtime test that existed at the time
# The mechanism, verified directly: ruff's F821 is a NAME-scope check, so it
# sees `_helper()` but not `self.missing_attr`; mypy reports both
# (`name-defined` AND `attr-defined`). So mypy strictly dominates on this class
# and ruff is the fast first pass — hence both, in that order.
# A combined "lint failed" message is worse than either alone, so they stay
# split and each prints the command to reproduce.
#
# Cost measured on this repo: ruff ~0.2s, mypy ~1.0s warm. Cheap enough to run
# on every commit, and both run BEFORE the `claude -p` semantic pass below so a
# syntax-level failure never waits on a network round-trip.
#
# CAVEAT: these check the WORKING TREE, not the staged snapshot. A commit made
# with unrelated unstaged edits present can therefore pass or fail on code that
# is not being committed. Checking the staged tree exactly would need a
# temporary checkout, which is not worth the complexity or the risk in a repo
# where several agents share a worktree — CI checks the real committed state.
#
# A missing tool WARNS rather than blocks: refusing to commit because a dev
# extra is not installed is hostile, and CI is the hard gate. Mirrors the
# `claude`-not-found path below.
if git diff --cached --name-only --diff-filter=ACM | grep -qE '\.py$'; then
  if command -v ruff >/dev/null 2>&1; then
    if ! ruff_out="$(cd "${repo_root}" && ruff check 2>&1)"; then
      echo "🚫 pre-commit lint gate: ruff check failed" >&2
      printf '%s\n' "${ruff_out}" >&2
      echo "   Reproduce: ruff check   (auto-fix many: ruff check --fix)" >&2
      echo "   Bypass consciously: git commit --no-verify" >&2
      exit 1
    fi
  else
    echo "⚠️  pre-commit lint gate: 'ruff' not found — skipping lint." >&2
    echo "   Install dev extras (pip install -e '.[dev]') to gate locally." >&2
  fi

  if command -v mypy >/dev/null 2>&1; then
    if ! mypy_out="$(cd "${repo_root}" && mypy src/ 2>&1)"; then
      echo "🚫 pre-commit type gate: mypy src/ failed" >&2
      printf '%s\n' "${mypy_out}" >&2
      echo "   Reproduce: mypy src/" >&2
      echo "   Bypass consciously: git commit --no-verify" >&2
      exit 1
    fi
  else
    echo "⚠️  pre-commit type gate: 'mypy' not found — skipping type check." >&2
    echo "   Install dev extras (pip install -e '.[dev]') to gate locally." >&2
  fi
fi

# Added content lines of the staged diff (what actually enters history). awk
# skips the `+++ ` file-header line and strips the single leading `+` marker, so
# a real added line whose content itself starts with `+` (e.g. `+sk-...`) is
# still scanned. The allowlist file is excluded so adding a token never trips it.
added="$(git diff --cached --no-color -U0 -- . ':(exclude).pii-allowlist.txt' \
  | awk '/^\+\+\+ /{next} /^\+/{print substr($0,2)}')"
[ -z "${added}" ] && exit 0

fail() {
  echo "🚫 pre-commit PII gate: $1" >&2
  echo "   Fix the diff, add the token to .pii-allowlist.txt if it is a known" >&2
  echo "   public/synthetic false positive, or bypass consciously: git commit --no-verify" >&2
  exit 1
}

# --- 1. Deterministic gate (always runs, even offline) ---------------------
# Here-strings (not `printf | grep`) so an early `grep -q` match can't SIGPIPE
# its upstream writer and flip the pipeline status under `pipefail`.

# Secrets / API keys / private keys.
#
# The alternation below is the SHARED artifact between this hook and
# src/brain/secret_patterns.py, which the ingest-time secret guard imports. The
# hook keeps its own copy because it must run offline, with no venv, from a
# `git commit` in any shell — it cannot `import brain`. Byte-equality is
# enforced by tests/test_secret_pattern_hook_parity.py, so adding a pattern in
# Python without regenerating this line turns the suite red.
#
#   Regenerate:  python -m brain.secret_patterns --emit-egrep
#
# --- BEGIN GENERATED: brain.secret_patterns.egrep_alternation() — do not edit by hand ---
_SECRET_RE='(AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[baprs]-[0-9A-Za-z-]{10,}|sk-[A-Za-z0-9]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk_live_[A-Za-z0-9]{20,}|rk_live_[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|glpat-[A-Za-z0-9_-]{18,}|AIza[0-9A-Za-z_-]{35})'
# --- END GENERATED ---

# Matches are EXTRACTED (-o) rather than merely detected, so allowlisted tokens
# can be subtracted before failing. Previously this stage ignored
# .pii-allowlist.txt entirely — only the semantic pass consulted it — which
# meant a synthetic credential fixture could never be committed at all, however
# obviously fake. tests/secret_fixtures.py needs exactly that, and the
# allowlist's own header already scopes it to "FALSE POSITIVES ONLY".
#
# Subtraction is EXACT-LINE (-x) and fixed-string (-F): a short allowlist entry
# like "API" cannot accidentally allow a longer real token that merely contains
# it. Blank/comment lines are stripped first — an empty -F pattern would match
# every line and silently disable the gate.
secret_hits="$(grep -oEi "${_SECRET_RE}" <<<"${added}" || true)"
if [ -n "${secret_hits}" ] && [ -f "${allowlist}" ]; then
  allow_tokens="$(grep -vE '^[[:space:]]*(#|$)' "${allowlist}" || true)"
  if [ -n "${allow_tokens}" ]; then
    secret_hits="$(grep -vixF -- "${allow_tokens}" <<<"${secret_hits}" || true)"
  fi
fi
if [ -n "${secret_hits}" ]; then
  fail "possible secret / API key in staged diff"
fi

# Real-looking email addresses. Allowed synthetic/example domains are anchored to
# the END of the address, so a lookalike that appends a longer suffix to a
# synthetic domain (e.g. a "example.com.evil" host) is NOT treated as synthetic.
#
# The optional `([A-Z0-9.-]+\.)?` prefix admits SUBDOMAINS of a reserved domain.
# RFC 2606 reserves everything under example.com/net/org, so `db.example.com` is
# exactly as synthetic as `example.com`; requiring the reserved name to sit
# immediately after the `@` rejected legitimate fixtures and taught people to
# reach for `--no-verify`, which disables every gate at once. The `$` anchor is
# retained, so `example.com.evil` is still caught.
#
# `test|example|invalid|localhost` also appear as bare TLDs because RFC 2606
# reserves them at that level (`person@example.invalid`), not only as
# second-level names under .com/.org/.net.
emails="$(grep -oEi '[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}' <<<"${added}" \
  | grep -viE '@([A-Z0-9.-]+\.)?((example|test|acme|contoso|northwind|invalid)\.(com|org|net)|(test|example|invalid|localhost))$' \
  || true)"
if [ -n "${emails}" ]; then
  fail "real-looking email address(es): $(printf '%s' "${emails}" | tr '\n' ' ')"
fi

# Absolute HOME paths — a real developer's machine layout, and with it a real
# account name.
#
# Why this exists: 13 occurrences of the repo owner's actual home path reached
# tracked files, and NEITHER stage could have stopped them. Stage 1 had no
# home-path pattern at all; stage 2's prompt enumerates names, emails, phones,
# addresses, employers, codenames, credentials and transcript bodies — machine
# layout was not a category it was ever asked about, so it was a CONCEPT absent,
# not a string absent. What landed after the cleanup was a re-derive command in
# .gitignore, which documents the class without gating it. This is the gate.
#
# It matches the SHAPE, never a value. That is deliberate and load-bearing: the
# name this check exists to keep out of history must not itself be written into
# a tracked file to block it (rule 15 — a denylist entry for a real username IS
# the disclosure). The gitignored .pii-denylist.local.txt remains the place for
# real values; this stage needs no such entry, because anything that is not a
# known-synthetic segment is blocked by default.
#
# The extraction stops at the next `/`, so only the FIRST segment — the account
# name — is compared: `/Users/you/workspace/x` yields `/Users/you`. Deeper path
# structure is not sensitive on its own and would otherwise defeat the anchors.
#
# Self-avoidance: the two lines below contain no substring matching the pattern
# they define (`/Users` is followed by `|` or `)`, never `/`), so this hook does
# not block its own commit. Comments here use only allowlisted placeholders for
# the same reason.
_HOME_PATH_RE='(/Users|/home)/[A-Za-z0-9._-]+'
# The placeholders the repo deliberately uses: /Users/you, /Users/example,
# /home/user, and /home/runner — the last being the GitHub Actions runner home,
# which is public infrastructure, not a person. Measured at `4740f03`: 56
# occurrences spread over 53 tracked lines, and NO fifth segment. Mind the unit
# — the command below counts occurrences, whereas `git grep -c` counts matching
# LINES, which is how the same census yields both 56 and 53. Re-derive the real
# list before editing this, and check whether a fifth segment has appeared:
#   git grep -hoIE '(/Users|/home)/[A-Za-z0-9._-]+' | sort | uniq -c | sort -rn
_SYNTHETIC_HOME_RE='^(/Users|/home)/(you|example|user|runner)$'

home_hits="$(grep -oEi "${_HOME_PATH_RE}" <<<"${added}" \
  | grep -viE "${_SYNTHETIC_HOME_RE}" || true)"

# Subtracted the same exact-line, fixed-string way as the secret stage, so a new
# synthetic placeholder can be admitted via .pii-allowlist.txt without widening
# the regex. Exact-line matching is what stops a short entry from allowing a
# longer real path that merely contains it.
if [ -n "${home_hits}" ] && [ -f "${allowlist}" ]; then
  allow_paths="$(grep -vE '^[[:space:]]*(#|$)' "${allowlist}" || true)"
  if [ -n "${allow_paths}" ]; then
    home_hits="$(grep -vixF -- "${allow_paths}" <<<"${home_hits}" || true)"
  fi
fi
if [ -n "${home_hits}" ]; then
  fail "absolute home path(s) revealing a real machine account: $(printf '%s' "${home_hits}" | sort -u | tr '\n' ' ')"
fi

# Real sensitive terms from the gitignored denylist — always block (case-insensitive
# substring). `|| [ -n "$term" ]` handles a final line with no trailing newline.
if [ -f "${denylist}" ]; then
  while IFS= read -r term || [ -n "${term}" ]; do
    [ -z "${term}" ] && continue
    case "${term}" in \#*) continue ;; esac
    if grep -qiF -- "${term}" <<<"${added}"; then
      fail "a denylisted sensitive term is present (see .pii-denylist.local.txt)"
    fi
  done < "${denylist}"
fi

# --- 2. Semantic pass via `claude -p` (best-effort; regex gate already ran) -

if ! command -v claude >/dev/null 2>&1; then
  echo "⚠️  pre-commit PII gate: 'claude' not found — ran the regex/denylist gate only." >&2
  echo "   Install Claude Code for the semantic pass, or rely on the deterministic gate." >&2
  exit 0
fi

allow=""
if [ -f "${allowlist}" ]; then
  allow="$(grep -vE '^[[:space:]]*(#|$)' "${allowlist}" | tr '\n' ',' || true)"
fi

prompt="You are a PII/secret gate for a git commit in a PERSONAL knowledge-base repo whose \
policy is SYNTHETIC-ONLY test and doc data. Review ONLY the STAGED DIFF added lines below. \
Print exactly 'OK' if clean, or 'BLOCK: <short reason>' if they contain REAL personal data \
(real person names, emails, phone numbers, postal addresses), real customer/employer/company \
names, internal project codenames, secrets/credentials, real meeting-transcript / \
email-body content, or a REAL MACHINE's filesystem layout — an absolute home directory such \
as /Users/<name> or /home/<name> whose account segment is a real person's username rather \
than a placeholder. Tokens in ALLOWLIST and obvious synthetic placeholders (Acme, Contoso, \
Jane/John Doe, Northwind, Sidekick, and the path stand-ins /Users/you, /Users/example, \
/home/user, /home/runner) are SAFE — never flag them. Output EXACTLY ONE line, \
nothing else."

# Capture stdout and exit status SEPARATELY (an `|| echo` fallback could let a
# non-zero exit slip through as a passing 'OK*' verdict — fail closed instead).
if verdict="$(printf 'ALLOWLIST (safe, never flag): %s\n\nSTAGED DIFF (added lines):\n%s\n' \
  "${allow}" "${added}" | claude -p "${prompt}" 2>/dev/null)"; then
  claude_rc=0
else
  claude_rc=$?
fi

[ "${claude_rc}" -ne 0 ] && \
  fail "semantic scan errored (claude exit ${claude_rc}) — re-run online, or bypass consciously with --no-verify"

# Accept ONLY a single, well-formed line. Anything else fails closed.
verdict="$(printf '%s' "${verdict}" | tr -d '\r')"
line_count="$(printf '%s\n' "${verdict}" | grep -c . || true)"
first_line="$(printf '%s\n' "${verdict}" | sed -n '1p')"

if [ "${line_count}" -gt 1 ]; then
  fail "ambiguous multi-line verdict from claude — review manually or bypass consciously"
fi
case "${first_line}" in
  OK)      exit 0 ;;
  BLOCK:*) fail "${first_line#BLOCK: }" ;;
  *)       fail "unrecognized verdict from claude ('${first_line:0:60}') — failing closed" ;;
esac
